{
  "code": "constellix",
  "name": "Constellix",
  "url": "https://constellix.com",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Constellix",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "CONSTELLIX_API_KEY": {
        "type": "string",
        "title": "CONSTELLIX_API_KEY",
        "description": "User API key",
        "secret": true,
        "x-group": "credentials"
      },
      "CONSTELLIX_HTTP_TIMEOUT": {
        "type": "string",
        "title": "CONSTELLIX_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "CONSTELLIX_POLLING_INTERVAL": {
        "type": "string",
        "title": "CONSTELLIX_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "CONSTELLIX_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "CONSTELLIX_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "CONSTELLIX_SECRET_KEY": {
        "type": "string",
        "title": "CONSTELLIX_SECRET_KEY",
        "description": "User secret key",
        "secret": true,
        "x-group": "credentials"
      },
      "CONSTELLIX_TTL": {
        "type": "string",
        "title": "CONSTELLIX_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-key-secret-key",
        "label": "API key + Secret key",
        "fields": [
          "CONSTELLIX_API_KEY",
          "CONSTELLIX_SECRET_KEY"
        ],
        "optional": []
      }
    ]
  }
}
