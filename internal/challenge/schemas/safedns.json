{
  "code": "safedns",
  "name": "UKFast SafeDNS",
  "url": "https://www.ukfast.co.uk/dns-hosting.html",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "UKFast SafeDNS",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "SAFEDNS_AUTH_TOKEN": {
        "type": "string",
        "title": "SAFEDNS_AUTH_TOKEN",
        "description": "Authentication token",
        "secret": true,
        "x-group": "credentials"
      },
      "SAFEDNS_HTTP_TIMEOUT": {
        "type": "string",
        "title": "SAFEDNS_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "SAFEDNS_POLLING_INTERVAL": {
        "type": "string",
        "title": "SAFEDNS_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "SAFEDNS_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "SAFEDNS_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "SAFEDNS_TTL": {
        "type": "string",
        "title": "SAFEDNS_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "auth-token",
        "label": "Auth token",
        "fields": [
          "SAFEDNS_AUTH_TOKEN"
        ],
        "optional": []
      }
    ]
  }
}
