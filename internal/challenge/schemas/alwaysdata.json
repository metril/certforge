{
  "code": "alwaysdata",
  "name": "Alwaysdata",
  "url": "https://alwaysdata.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Alwaysdata",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ALWAYSDATA_ACCOUNT": {
        "type": "string",
        "title": "ALWAYSDATA_ACCOUNT",
        "description": "Account name",
        "secret": false,
        "x-group": "additional"
      },
      "ALWAYSDATA_API_KEY": {
        "type": "string",
        "title": "ALWAYSDATA_API_KEY",
        "description": "API Key",
        "secret": true,
        "x-group": "credentials"
      },
      "ALWAYSDATA_HTTP_TIMEOUT": {
        "type": "string",
        "title": "ALWAYSDATA_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "ALWAYSDATA_POLLING_INTERVAL": {
        "type": "string",
        "title": "ALWAYSDATA_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "ALWAYSDATA_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "ALWAYSDATA_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "ALWAYSDATA_TTL": {
        "type": "string",
        "title": "ALWAYSDATA_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-key",
        "label": "API key",
        "fields": [
          "ALWAYSDATA_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
