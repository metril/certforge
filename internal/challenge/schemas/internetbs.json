{
  "code": "internetbs",
  "name": "Internet.bs",
  "url": "https://internetbs.net",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Internet.bs",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "INTERNET_BS_API_KEY": {
        "type": "string",
        "title": "INTERNET_BS_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "INTERNET_BS_HTTP_TIMEOUT": {
        "type": "string",
        "title": "INTERNET_BS_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "INTERNET_BS_PASSWORD": {
        "type": "string",
        "title": "INTERNET_BS_PASSWORD",
        "description": "API password",
        "secret": true,
        "x-group": "credentials"
      },
      "INTERNET_BS_POLLING_INTERVAL": {
        "type": "string",
        "title": "INTERNET_BS_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "INTERNET_BS_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "INTERNET_BS_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "INTERNET_BS_TTL": {
        "type": "string",
        "title": "INTERNET_BS_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 3600)",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
