{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wait",
  "description": "Pauses before the next step, for example while a service restarts. Runs on the server.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seconds"],
  "properties": {
    "seconds": {"type": "integer", "minimum": 1, "maximum": 300, "title": "Seconds"}
  }
}
