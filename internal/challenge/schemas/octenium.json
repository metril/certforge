{
  "code": "octenium",
  "name": "Octenium",
  "url": "https://octenium.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Octenium",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "OCTENIUM_API_KEY": {
        "type": "string",
        "title": "OCTENIUM_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "OCTENIUM_HTTP_TIMEOUT": {
        "type": "string",
        "title": "OCTENIUM_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "OCTENIUM_POLLING_INTERVAL": {
        "type": "string",
        "title": "OCTENIUM_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "OCTENIUM_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "OCTENIUM_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "OCTENIUM_TTL": {
        "type": "string",
        "title": "OCTENIUM_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-key",
        "label": "API key",
        "fields": [
          "OCTENIUM_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
