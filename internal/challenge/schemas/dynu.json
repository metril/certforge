{
  "code": "dynu",
  "name": "Dynu",
  "url": "https://www.dynu.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Dynu",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "DYNU_API_KEY": {
        "type": "string",
        "title": "DYNU_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "DYNU_HTTP_TIMEOUT": {
        "type": "string",
        "title": "DYNU_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "DYNU_POLLING_INTERVAL": {
        "type": "string",
        "title": "DYNU_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "DYNU_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "DYNU_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 180)",
        "secret": false,
        "x-group": "additional"
      },
      "DYNU_TTL": {
        "type": "string",
        "title": "DYNU_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-key",
        "label": "API key",
        "fields": [
          "DYNU_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
