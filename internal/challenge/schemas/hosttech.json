{
  "code": "hosttech",
  "name": "Hosttech",
  "url": "https://www.hosttech.eu/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Hosttech",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "HOSTTECH_API_KEY": {
        "type": "string",
        "title": "HOSTTECH_API_KEY",
        "description": "API login",
        "secret": true,
        "x-group": "credentials"
      },
      "HOSTTECH_HTTP_TIMEOUT": {
        "type": "string",
        "title": "HOSTTECH_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "HOSTTECH_PASSWORD": {
        "type": "string",
        "title": "HOSTTECH_PASSWORD",
        "description": "API password",
        "secret": true,
        "x-group": "credentials"
      },
      "HOSTTECH_POLLING_INTERVAL": {
        "type": "string",
        "title": "HOSTTECH_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "HOSTTECH_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "HOSTTECH_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "HOSTTECH_TTL": {
        "type": "string",
        "title": "HOSTTECH_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 3600)",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
