# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/certforge-agent ./cmd/certforge-agent

# Runs as root on purpose: applying a layout's owner and group needs chown.
# Run it with --user to drop that (owner/group are then ignored with one
# warning). See docs/reference/agent.md.
FROM gcr.io/distroless/static-debian12
COPY --from=build /out/certforge-agent /usr/local/bin/certforge-agent
ENV CF_AGENT_DATA=/data
VOLUME /data
ENTRYPOINT ["/usr/local/bin/certforge-agent"]
CMD ["run"]
