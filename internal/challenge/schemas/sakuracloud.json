{
  "code": "sakuracloud",
  "name": "Sakura Cloud",
  "url": "https://cloud.sakura.ad.jp/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Sakura Cloud",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "SAKURACLOUD_ACCESS_TOKEN": {
        "type": "string",
        "title": "SAKURACLOUD_ACCESS_TOKEN",
        "description": "Access token",
        "secret": true,
        "x-group": "credentials"
      },
      "SAKURACLOUD_ACCESS_TOKEN_SECRET": {
        "type": "string",
        "title": "SAKURACLOUD_ACCESS_TOKEN_SECRET",
        "description": "Access token secret",
        "secret": true,
        "x-group": "credentials"
      },
      "SAKURACLOUD_HTTP_TIMEOUT": {
        "type": "string",
        "title": "SAKURACLOUD_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "SAKURACLOUD_POLLING_INTERVAL": {
        "type": "string",
        "title": "SAKURACLOUD_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "SAKURACLOUD_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "SAKURACLOUD_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "SAKURACLOUD_TTL": {
        "type": "string",
        "title": "SAKURACLOUD_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "token-token-secret",
        "label": "Token + Token secret",
        "fields": [
          "SAKURACLOUD_ACCESS_TOKEN",
          "SAKURACLOUD_ACCESS_TOKEN_SECRET"
        ],
        "optional": []
      }
    ]
  }
}
