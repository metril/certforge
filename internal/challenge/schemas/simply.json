{
  "code": "simply",
  "name": "Simply.com",
  "url": "https://www.simply.com/en/domains/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Simply.com",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "SIMPLY_ACCOUNT_NAME": {
        "type": "string",
        "title": "SIMPLY_ACCOUNT_NAME",
        "description": "Account name",
        "secret": false,
        "x-group": "credentials"
      },
      "SIMPLY_API_KEY": {
        "type": "string",
        "title": "SIMPLY_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "SIMPLY_HTTP_TIMEOUT": {
        "type": "string",
        "title": "SIMPLY_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "SIMPLY_POLLING_INTERVAL": {
        "type": "string",
        "title": "SIMPLY_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "SIMPLY_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "SIMPLY_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      },
      "SIMPLY_TTL": {
        "type": "string",
        "title": "SIMPLY_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "account-name-api-key",
        "label": "Account name + API key",
        "fields": [
          "SIMPLY_ACCOUNT_NAME",
          "SIMPLY_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
