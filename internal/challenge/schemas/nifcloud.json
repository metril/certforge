{
  "code": "nifcloud",
  "name": "NIFCloud",
  "url": "https://www.nifcloud.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "NIFCloud",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "NIFCLOUD_ACCESS_KEY_ID": {
        "type": "string",
        "title": "NIFCLOUD_ACCESS_KEY_ID",
        "description": "Access key",
        "secret": false,
        "x-group": "credentials"
      },
      "NIFCLOUD_HTTP_TIMEOUT": {
        "type": "string",
        "title": "NIFCLOUD_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "NIFCLOUD_POLLING_INTERVAL": {
        "type": "string",
        "title": "NIFCLOUD_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "NIFCLOUD_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "NIFCLOUD_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "NIFCLOUD_SECRET_ACCESS_KEY": {
        "type": "string",
        "title": "NIFCLOUD_SECRET_ACCESS_KEY",
        "description": "Secret access key",
        "secret": true,
        "x-group": "credentials"
      },
      "NIFCLOUD_TTL": {
        "type": "string",
        "title": "NIFCLOUD_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "access-key-id-secret-access-key",
        "label": "Access key ID + Secret access key",
        "fields": [
          "NIFCLOUD_ACCESS_KEY_ID",
          "NIFCLOUD_SECRET_ACCESS_KEY"
        ],
        "optional": []
      }
    ]
  }
}
