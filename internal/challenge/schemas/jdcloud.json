{
  "code": "jdcloud",
  "name": "JD Cloud",
  "url": "https://www.jdcloud.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "JD Cloud",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "JDCLOUD_ACCESS_KEY_ID": {
        "type": "string",
        "title": "JDCLOUD_ACCESS_KEY_ID",
        "description": "Access key ID",
        "secret": false,
        "x-group": "credentials"
      },
      "JDCLOUD_ACCESS_KEY_SECRET": {
        "type": "string",
        "title": "JDCLOUD_ACCESS_KEY_SECRET",
        "description": "Access key secret",
        "secret": true,
        "x-group": "credentials"
      },
      "JDCLOUD_HTTP_TIMEOUT": {
        "type": "string",
        "title": "JDCLOUD_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "JDCLOUD_POLLING_INTERVAL": {
        "type": "string",
        "title": "JDCLOUD_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "JDCLOUD_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "JDCLOUD_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "JDCLOUD_REGION_ID": {
        "type": "string",
        "title": "JDCLOUD_REGION_ID",
        "description": "Region ID (Default: cn-north-1)",
        "secret": false,
        "x-group": "additional"
      },
      "JDCLOUD_TTL": {
        "type": "string",
        "title": "JDCLOUD_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "id-secret",
        "label": "ID + Secret",
        "fields": [
          "JDCLOUD_ACCESS_KEY_ID",
          "JDCLOUD_ACCESS_KEY_SECRET"
        ],
        "optional": []
      }
    ]
  }
}
