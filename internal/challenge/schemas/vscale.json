{
  "code": "vscale",
  "name": "Vscale",
  "url": "https://vscale.io/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Vscale",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "VSCALE_API_TOKEN": {
        "type": "string",
        "title": "VSCALE_API_TOKEN",
        "description": "API token",
        "secret": true,
        "x-group": "credentials"
      },
      "VSCALE_BASE_URL": {
        "type": "string",
        "title": "VSCALE_BASE_URL",
        "description": "API endpoint URL",
        "secret": false,
        "x-group": "additional"
      },
      "VSCALE_HTTP_TIMEOUT": {
        "type": "string",
        "title": "VSCALE_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "VSCALE_POLLING_INTERVAL": {
        "type": "string",
        "title": "VSCALE_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "VSCALE_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "VSCALE_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "VSCALE_TTL": {
        "type": "string",
        "title": "VSCALE_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
