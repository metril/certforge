{
  "code": "oraclecloud",
  "name": "Oracle Cloud",
  "url": "https://cloud.oracle.com/home",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Oracle Cloud",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "OCI_AUTH_TYPE": {
        "type": "string",
        "title": "OCI_AUTH_TYPE",
        "description": "Authorization type. Possible values: 'instance_principal', 'user_principal', ''. (Default: '')",
        "secret": false,
        "x-group": "additional"
      },
      "OCI_COMPARTMENT_OCID": {
        "type": "string",
        "title": "OCI_COMPARTMENT_OCID",
        "description": "Compartment OCID",
        "secret": false,
        "x-group": "credentials"
      },
      "OCI_CONFIG_FILE": {
        "type": "string",
        "title": "OCI_CONFIG_FILE",
        "description": "Path to the configuration file. (only for `OCI_AUTH_TYPE=user_principal`)",
        "secret": false,
        "serverPath": true,
        "x-group": "additional"
      },
      "OCI_FINGERPRINT": {
        "type": "string",
        "title": "OCI_FINGERPRINT",
        "description": "Public key fingerprint (ignored if `OCI_AUTH_TYPE` is not empty)",
        "secret": false,
        "x-group": "credentials"
      },
      "OCI_HTTP_TIMEOUT": {
        "type": "string",
        "title": "OCI_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "OCI_POLLING_INTERVAL": {
        "type": "string",
        "title": "OCI_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "OCI_PRIVATE_KEY_PASSWORD": {
        "type": "string",
        "title": "OCI_PRIVATE_KEY_PASSWORD",
        "description": "Private key password (ignored if `OCI_AUTH_TYPE` is not empty)",
        "secret": true,
        "x-group": "credentials"
      },
      "OCI_PRIVATE_KEY_PATH": {
        "type": "string",
        "title": "OCI_PRIVATE_KEY_PATH",
        "description": "Private key file (ignored if `OCI_AUTH_TYPE` is not empty)",
        "secret": false,
        "serverPath": true,
        "x-group": "credentials"
      },
      "OCI_PRIVKEY": {
        "type": "string",
        "title": "OCI_PRIVKEY",
        "description": "Base64-encoded PEM private key (base64 of the whole PEM file), inline; alternative to OCI_PRIVKEY_FILE",
        "secret": true,
        "x-group": "credentials"
      },
      "OCI_PROFILE": {
        "type": "string",
        "title": "OCI_PROFILE",
        "description": "Profile name. (only for `OCI_AUTH_TYPE=user_principal`)",
        "secret": false,
        "x-group": "additional"
      },
      "OCI_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "OCI_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "OCI_REGION": {
        "type": "string",
        "title": "OCI_REGION",
        "description": "Region (it can be empty if `OCI_AUTH_TYPE` is not empty).",
        "secret": false,
        "x-group": "credentials"
      },
      "OCI_TENANCY_OCID": {
        "type": "string",
        "title": "OCI_TENANCY_OCID",
        "description": "Tenancy OCID (ignored if `OCI_AUTH_TYPE` is not empty)",
        "secret": false,
        "x-group": "credentials"
      },
      "OCI_TTL": {
        "type": "string",
        "title": "OCI_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "OCI_USER_OCID": {
        "type": "string",
        "title": "OCI_USER_OCID",
        "description": "User OCID (ignored if `OCI_AUTH_TYPE` is not empty)",
        "secret": false,
        "x-group": "credentials"
      }
    },
    "x-auth-methods": [
      {
        "id": "compartment-ocid",
        "label": "Compartment OCID",
        "fields": [
          "OCI_COMPARTMENT_OCID"
        ],
        "optional": [
          "OCI_FINGERPRINT",
          "OCI_PRIVATE_KEY_PASSWORD",
          "OCI_PRIVKEY",
          "OCI_REGION",
          "OCI_TENANCY_OCID",
          "OCI_USER_OCID"
        ]
      },
      {
        "id": "compartment-ocid-profile",
        "label": "Compartment OCID + Profile",
        "fields": [
          "OCI_COMPARTMENT_OCID",
          "OCI_PROFILE"
        ],
        "optional": [
          "OCI_FINGERPRINT",
          "OCI_PRIVATE_KEY_PASSWORD",
          "OCI_PRIVKEY",
          "OCI_REGION",
          "OCI_TENANCY_OCID",
          "OCI_USER_OCID"
        ]
      },
      {
        "id": "compartment-ocid-2",
        "label": "Compartment OCID",
        "fields": [
          "OCI_COMPARTMENT_OCID"
        ],
        "optional": [
          "OCI_FINGERPRINT",
          "OCI_PRIVATE_KEY_PASSWORD",
          "OCI_PRIVKEY",
          "OCI_REGION",
          "OCI_TENANCY_OCID",
          "OCI_USER_OCID"
        ]
      }
    ]
  }
}
