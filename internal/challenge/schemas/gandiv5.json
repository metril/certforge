{
  "code": "gandiv5",
  "name": "Gandi Live DNS (v5)",
  "url": "https://www.gandi.net",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Gandi Live DNS (v5)",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "GANDIV5_API_KEY": {
        "type": "string",
        "title": "GANDIV5_API_KEY",
        "description": "API key (Deprecated)",
        "secret": true,
        "x-group": "credentials"
      },
      "GANDIV5_HTTP_TIMEOUT": {
        "type": "string",
        "title": "GANDIV5_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "GANDIV5_PERSONAL_ACCESS_TOKEN": {
        "type": "string",
        "title": "GANDIV5_PERSONAL_ACCESS_TOKEN",
        "description": "Personal Access Token",
        "secret": true,
        "x-group": "credentials"
      },
      "GANDIV5_POLLING_INTERVAL": {
        "type": "string",
        "title": "GANDIV5_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 20)",
        "secret": false,
        "x-group": "additional"
      },
      "GANDIV5_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "GANDIV5_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 1200)",
        "secret": false,
        "x-group": "additional"
      },
      "GANDIV5_TTL": {
        "type": "string",
        "title": "GANDIV5_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "personal-access-token",
        "label": "Personal access token",
        "fields": [
          "GANDIV5_PERSONAL_ACCESS_TOKEN"
        ],
        "optional": []
      },
      {
        "id": "api-key",
        "label": "API key (deprecated)",
        "fields": [
          "GANDIV5_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
