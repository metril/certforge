{
  "code": "godaddy",
  "name": "Go Daddy",
  "url": "https://godaddy.com",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Go Daddy",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "GODADDY_API_KEY": {
        "type": "string",
        "title": "GODADDY_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "GODADDY_API_SECRET": {
        "type": "string",
        "title": "GODADDY_API_SECRET",
        "description": "API secret",
        "secret": true,
        "x-group": "credentials"
      },
      "GODADDY_HTTP_TIMEOUT": {
        "type": "string",
        "title": "GODADDY_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "GODADDY_POLLING_INTERVAL": {
        "type": "string",
        "title": "GODADDY_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "GODADDY_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "GODADDY_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "GODADDY_TTL": {
        "type": "string",
        "title": "GODADDY_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 600)",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
