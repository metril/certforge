{
  "code": "vinyldns",
  "name": "VinylDNS",
  "url": "https://www.vinyldns.io",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "VinylDNS",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "VINYLDNS_ACCESS_KEY": {
        "type": "string",
        "title": "VINYLDNS_ACCESS_KEY",
        "description": "The VinylDNS API key",
        "secret": true,
        "x-group": "credentials"
      },
      "VINYLDNS_HOST": {
        "type": "string",
        "title": "VINYLDNS_HOST",
        "description": "The VinylDNS API URL",
        "secret": false,
        "x-group": "credentials"
      },
      "VINYLDNS_HTTP_TIMEOUT": {
        "type": "string",
        "title": "VINYLDNS_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "VINYLDNS_POLLING_INTERVAL": {
        "type": "string",
        "title": "VINYLDNS_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 4)",
        "secret": false,
        "x-group": "additional"
      },
      "VINYLDNS_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "VINYLDNS_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "VINYLDNS_QUOTE_VALUE": {
        "type": "string",
        "title": "VINYLDNS_QUOTE_VALUE",
        "description": "Adds quotes around the TXT record value (Default: false)",
        "secret": false,
        "x-group": "additional"
      },
      "VINYLDNS_SECRET_KEY": {
        "type": "string",
        "title": "VINYLDNS_SECRET_KEY",
        "description": "The VinylDNS API Secret key",
        "secret": true,
        "x-group": "credentials"
      },
      "VINYLDNS_TTL": {
        "type": "string",
        "title": "VINYLDNS_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "access-key-secret-key-host",
        "label": "Access key + Secret key + Host",
        "fields": [
          "VINYLDNS_ACCESS_KEY",
          "VINYLDNS_SECRET_KEY",
          "VINYLDNS_HOST"
        ],
        "optional": []
      }
    ]
  }
}
