{
  "code": "conohav3",
  "name": "ConoHa v3",
  "url": "https://www.conoha.jp/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ConoHa v3",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "CONOHAV3_API_PASSWORD": {
        "type": "string",
        "title": "CONOHAV3_API_PASSWORD",
        "description": "The API password",
        "secret": true,
        "x-group": "credentials"
      },
      "CONOHAV3_API_USER_ID": {
        "type": "string",
        "title": "CONOHAV3_API_USER_ID",
        "description": "The API user ID",
        "secret": false,
        "x-group": "credentials"
      },
      "CONOHAV3_HTTP_TIMEOUT": {
        "type": "string",
        "title": "CONOHAV3_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "CONOHAV3_POLLING_INTERVAL": {
        "type": "string",
        "title": "CONOHAV3_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "CONOHAV3_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "CONOHAV3_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "CONOHAV3_REGION": {
        "type": "string",
        "title": "CONOHAV3_REGION",
        "description": "The region (Default: c3j1)",
        "secret": false,
        "x-group": "additional"
      },
      "CONOHAV3_TENANT_ID": {
        "type": "string",
        "title": "CONOHAV3_TENANT_ID",
        "description": "Tenant ID",
        "secret": false,
        "x-group": "credentials"
      },
      "CONOHAV3_TTL": {
        "type": "string",
        "title": "CONOHAV3_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "tenant-id-api-user-id-api-password",
        "label": "Tenant ID + API user ID + API password",
        "fields": [
          "CONOHAV3_TENANT_ID",
          "CONOHAV3_API_USER_ID",
          "CONOHAV3_API_PASSWORD"
        ],
        "optional": []
      }
    ]
  }
}
