{
  "code": "loopia",
  "name": "Loopia",
  "url": "https://loopia.com",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Loopia",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "LOOPIA_API_PASSWORD": {
        "type": "string",
        "title": "LOOPIA_API_PASSWORD",
        "description": "API password",
        "secret": true,
        "x-group": "credentials"
      },
      "LOOPIA_API_URL": {
        "type": "string",
        "title": "LOOPIA_API_URL",
        "description": "API endpoint. Ex: https://api.loopia.se/RPCSERV or https://api.loopia.rs/RPCSERV",
        "secret": false,
        "x-group": "additional"
      },
      "LOOPIA_API_USER": {
        "type": "string",
        "title": "LOOPIA_API_USER",
        "description": "API username",
        "secret": false,
        "x-group": "credentials"
      },
      "LOOPIA_HTTP_TIMEOUT": {
        "type": "string",
        "title": "LOOPIA_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "LOOPIA_POLLING_INTERVAL": {
        "type": "string",
        "title": "LOOPIA_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2400)",
        "secret": false,
        "x-group": "additional"
      },
      "LOOPIA_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "LOOPIA_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "LOOPIA_TTL": {
        "type": "string",
        "title": "LOOPIA_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "user-password",
        "label": "User + Password",
        "fields": [
          "LOOPIA_API_USER",
          "LOOPIA_API_PASSWORD"
        ],
        "optional": []
      }
    ]
  }
}
