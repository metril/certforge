{
  "code": "porkbun",
  "name": "Porkbun",
  "url": "https://porkbun.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Porkbun",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "PORKBUN_API_KEY": {
        "type": "string",
        "title": "PORKBUN_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "PORKBUN_HTTP_TIMEOUT": {
        "type": "string",
        "title": "PORKBUN_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "PORKBUN_POLLING_INTERVAL": {
        "type": "string",
        "title": "PORKBUN_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "PORKBUN_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "PORKBUN_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 600)",
        "secret": false,
        "x-group": "additional"
      },
      "PORKBUN_SECRET_API_KEY": {
        "type": "string",
        "title": "PORKBUN_SECRET_API_KEY",
        "description": "secret API key",
        "secret": true,
        "x-group": "credentials"
      },
      "PORKBUN_TTL": {
        "type": "string",
        "title": "PORKBUN_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "secret-api-key-api-key",
        "label": "Secret API key + API key",
        "fields": [
          "PORKBUN_SECRET_API_KEY",
          "PORKBUN_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
