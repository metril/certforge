{
  "code": "rackspace",
  "name": "Rackspace",
  "url": "https://www.rackspace.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Rackspace",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "RACKSPACE_API_KEY": {
        "type": "string",
        "title": "RACKSPACE_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "RACKSPACE_HTTP_TIMEOUT": {
        "type": "string",
        "title": "RACKSPACE_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "RACKSPACE_POLLING_INTERVAL": {
        "type": "string",
        "title": "RACKSPACE_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 3)",
        "secret": false,
        "x-group": "additional"
      },
      "RACKSPACE_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "RACKSPACE_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "RACKSPACE_TTL": {
        "type": "string",
        "title": "RACKSPACE_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      },
      "RACKSPACE_USER": {
        "type": "string",
        "title": "RACKSPACE_USER",
        "description": "API user",
        "secret": false,
        "x-group": "credentials"
      }
    },
    "x-auth-methods": [
      {
        "id": "user-api-key",
        "label": "User + API key",
        "fields": [
          "RACKSPACE_USER",
          "RACKSPACE_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
