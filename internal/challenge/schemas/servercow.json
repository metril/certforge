{
  "code": "servercow",
  "name": "Servercow",
  "url": "https://servercow.de/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Servercow",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "SERVERCOW_HTTP_TIMEOUT": {
        "type": "string",
        "title": "SERVERCOW_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "SERVERCOW_PASSWORD": {
        "type": "string",
        "title": "SERVERCOW_PASSWORD",
        "description": "API password",
        "secret": true,
        "x-group": "credentials"
      },
      "SERVERCOW_POLLING_INTERVAL": {
        "type": "string",
        "title": "SERVERCOW_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "SERVERCOW_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "SERVERCOW_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "SERVERCOW_TTL": {
        "type": "string",
        "title": "SERVERCOW_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "SERVERCOW_USERNAME": {
        "type": "string",
        "title": "SERVERCOW_USERNAME",
        "description": "API username",
        "secret": false,
        "x-group": "credentials"
      }
    },
    "x-auth-methods": [
      {
        "id": "username-password",
        "label": "Username + Password",
        "fields": [
          "SERVERCOW_USERNAME",
          "SERVERCOW_PASSWORD"
        ],
        "optional": []
      }
    ]
  }
}
