{
  "code": "metaregistrar",
  "name": "Metaregistrar",
  "url": "https://metaregistrar.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Metaregistrar",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "METAREGISTRAR_API_TOKEN": {
        "type": "string",
        "title": "METAREGISTRAR_API_TOKEN",
        "description": "The API token",
        "secret": true,
        "x-group": "credentials"
      },
      "METAREGISTRAR_HTTP_TIMEOUT": {
        "type": "string",
        "title": "METAREGISTRAR_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "METAREGISTRAR_POLLING_INTERVAL": {
        "type": "string",
        "title": "METAREGISTRAR_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "METAREGISTRAR_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "METAREGISTRAR_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "METAREGISTRAR_TTL": {
        "type": "string",
        "title": "METAREGISTRAR_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-token",
        "label": "API token",
        "fields": [
          "METAREGISTRAR_API_TOKEN"
        ],
        "optional": []
      }
    ]
  }
}
