# syntax=docker/dockerfile:1.7
ARG WITH_WEB=1

FROM --platform=$BUILDPLATFORM node:26-alpine AS webbuild
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM scratch AS web-1
COPY --from=webbuild /src/web/dist /dist

FROM --platform=$BUILDPLATFORM alpine:3.24 AS web-0
RUN mkdir -p /dist

FROM web-${WITH_WEB} AS web

FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
ARG WITH_WEB=1
ARG GO_TAGS=""
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /dist /tmp/webdist
RUN set -eux; tags="$GO_TAGS"; \
    if [ "$WITH_WEB" = "1" ]; then rm -rf internal/webui/dist && cp -r /tmp/webdist internal/webui/dist && find internal/webui/dist -name "*.map" -delete && tags="$tags embedweb"; fi; \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -tags "$tags" -ldflags "-s -w -X main.version=${VERSION}" -o /out/certforge ./cmd/certforge

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/certforge /usr/local/bin/certforge
USER nonroot:nonroot
EXPOSE 8080 8443
ENTRYPOINT ["/usr/local/bin/certforge"]
CMD ["serve"]
