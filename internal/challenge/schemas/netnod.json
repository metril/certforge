{
  "code": "netnod",
  "name": "Netnod",
  "url": "https://www.netnod.se/dns/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Netnod",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "NETNOD_HTTP_TIMEOUT": {
        "type": "string",
        "title": "NETNOD_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "NETNOD_POLLING_INTERVAL": {
        "type": "string",
        "title": "NETNOD_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "NETNOD_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "NETNOD_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "NETNOD_TOKEN": {
        "type": "string",
        "title": "NETNOD_TOKEN",
        "description": "API token",
        "secret": true,
        "x-group": "credentials"
      },
      "NETNOD_TTL": {
        "type": "string",
        "title": "NETNOD_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "token",
        "label": "Token",
        "fields": [
          "NETNOD_TOKEN"
        ],
        "optional": []
      }
    ]
