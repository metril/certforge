{
  "code": "com35",
  "name": "35.com/三五互联",
  "url": "https://www.35.cn/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "35.com/三五互联",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "COM35_HTTP_TIMEOUT": {
        "type": "string",
        "title": "COM35_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "COM35_PASSWORD": {
        "type": "string",
        "title": "COM35_PASSWORD",
        "description": "API password",
        "secret": true,
        "x-group": "credentials"
      },
      "COM35_POLLING_INTERVAL": {
        "type": "string",
        "title": "COM35_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "COM35_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "COM35_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "COM35_TTL": {
        "type": "string",
        "title": "COM35_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "COM35_USERNAME": {
        "type": "string",
        "title": "COM35_USERNAME",
        "description": "Username",
        "secret": false,
        "x-group": "credentials"
      }
    },
    "x-auth-methods": [
      {
        "id": "username-password",
        "label": "Username + Password",
        "fields": [
          "COM35_USERNAME",
          "COM35_PASSWORD"
