{
  "code": "selfhostde",
  "name": "SelfHost.(de|eu)",
  "url": "https://www.selfhost.de",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SelfHost.(de|eu)",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "SELFHOSTDE_HTTP_TIMEOUT": {
        "type": "string",
        "title": "SELFHOSTDE_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "SELFHOSTDE_PASSWORD": {
        "type": "string",
        "title": "SELFHOSTDE_PASSWORD",
        "description": "Password",
        "secret": true,
        "x-group": "credentials"
      },
      "SELFHOSTDE_POLLING_INTERVAL": {
        "type": "string",
        "title": "SELFHOSTDE_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "SELFHOSTDE_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "SELFHOSTDE_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 240)",
        "secret": false,
        "x-group": "additional"
      },
      "SELFHOSTDE_RECORDS_MAPPING": {
        "type": "string",
        "title": "SELFHOSTDE_RECORDS_MAPPING",
        "description": "Record IDs mapping with domains (ex: example.com:123:456,example.org:789,foo.example.com:147)",
        "secret": false,
        "x-group": "credentials"
      },
      "SELFHOSTDE_TTL": {
        "type": "string",
        "title": "SELFHOSTDE_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "SELFHOSTDE_USERNAME": {
        "type": "string",
        "title": "SELFHOSTDE_USERNAME",
        "description": "Username",
        "secret": false,
        "x-group": "credentials"
      }
    },
    "x-auth-methods": [
      {
        "id": "username-password-records-mapping",
        "label": "Username + Password + Records mapping",
        "fields": [
          "SELFHOSTDE_USERNAME",
          "SELFHOSTDE_PASSWORD",
          "SELFHOSTDE_RECORDS_MAPPING"
        ],
        "optional": []
      }
    ]
  }
}
