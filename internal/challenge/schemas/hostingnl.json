{
  "code": "hostingnl",
  "name": "Hosting.nl",
  "url": "https://hosting.nl",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Hosting.nl",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "HOSTINGNL_API_KEY": {
        "type": "string",
        "title": "HOSTINGNL_API_KEY",
        "description": "The API key",
        "secret": true,
        "x-group": "credentials"
      },
      "HOSTINGNL_HTTP_TIMEOUT": {
        "type": "string",
        "title": "HOSTINGNL_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "HOSTINGNL_POLLING_INTERVAL": {
        "type": "string",
        "title": "HOSTINGNL_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "HOSTINGNL_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "HOSTINGNL_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "HOSTINGNL_TTL": {
        "type": "string",
        "title": "HOSTINGNL_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-key",
        "label": "API key",
        "fields": [
          "HOSTINGNL_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
