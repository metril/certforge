{
  "code": "webnamesca",
  "name": "webnames.ca",
  "url": "https://www.webnames.ca/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "webnames.ca",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "WEBNAMESCA_API_KEY": {
        "type": "string",
        "title": "WEBNAMESCA_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "WEBNAMESCA_API_USER": {
        "type": "string",
        "title": "WEBNAMESCA_API_USER",
        "description": "API username",
        "secret": false,
        "x-group": "credentials"
      },
      "WEBNAMESCA_HTTP_TIMEOUT": {
        "type": "string",
        "title": "WEBNAMESCA_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "WEBNAMESCA_POLLING_INTERVAL": {
        "type": "string",
        "title": "WEBNAMESCA_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "WEBNAMESCA_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "WEBNAMESCA_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "WEBNAMESCA_TTL": {
        "type": "string",
        "title": "WEBNAMESCA_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "user-key",
        "label": "User + Key",
        "fields": [
          "WEBNAMESCA_API_USER",
          "WEBNAMESCA_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
