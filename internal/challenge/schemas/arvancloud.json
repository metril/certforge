{
  "code": "arvancloud",
  "name": "ArvanCloud",
  "url": "https://arvancloud.ir",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ArvanCloud",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ARVANCLOUD_API_KEY": {
        "type": "string",
        "title": "ARVANCLOUD_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "ARVANCLOUD_HTTP_TIMEOUT": {
        "type": "string",
        "title": "ARVANCLOUD_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "ARVANCLOUD_POLLING_INTERVAL": {
        "type": "string",
        "title": "ARVANCLOUD_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "ARVANCLOUD_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "ARVANCLOUD_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "ARVANCLOUD_TTL": {
        "type": "string",
        "title": "ARVANCLOUD_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 600)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-key",
        "label": "API key",
        "fields": [
          "ARVANCLOUD_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
