{
  "code": "infomaniak",
  "name": "Infomaniak",
  "url": "https://www.infomaniak.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Infomaniak",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "INFOMANIAK_ACCESS_TOKEN": {
        "type": "string",
        "title": "INFOMANIAK_ACCESS_TOKEN",
        "description": "Access token",
        "secret": true,
        "x-group": "credentials"
      },
      "INFOMANIAK_ENDPOINT": {
        "type": "string",
        "title": "INFOMANIAK_ENDPOINT",
        "description": "https://api.infomaniak.com",
        "secret": false,
        "x-group": "additional"
      },
      "INFOMANIAK_HTTP_TIMEOUT": {
        "type": "string",
        "title": "INFOMANIAK_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "INFOMANIAK_POLLING_INTERVAL": {
        "type": "string",
        "title": "INFOMANIAK_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "INFOMANIAK_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "INFOMANIAK_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "INFOMANIAK_TTL": {
        "type": "string",
        "title": "INFOMANIAK_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
