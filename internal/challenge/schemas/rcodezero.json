{
  "code": "rcodezero",
  "name": "RcodeZero",
  "url": "https://www.rcodezero.at/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RcodeZero",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "RCODEZERO_API_TOKEN": {
        "type": "string",
        "title": "RCODEZERO_API_TOKEN",
        "description": "API token",
        "secret": true,
        "x-group": "credentials"
      },
      "RCODEZERO_HTTP_TIMEOUT": {
        "type": "string",
        "title": "RCODEZERO_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "RCODEZERO_POLLING_INTERVAL": {
        "type": "string",
        "title": "RCODEZERO_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "RCODEZERO_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "RCODEZERO_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 240)",
        "secret": false,
        "x-group": "additional"
      },
      "RCODEZERO_TTL": {
        "type": "string",
        "title": "RCODEZERO_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-token",
        "label": "API token",
        "fields": [
          "RCODEZERO_API_TOKEN"
        ],
        "optional": []
      }
    ]
  }
}
