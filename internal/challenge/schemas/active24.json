{
  "code": "active24",
  "name": "Active24",
  "url": "https://www.active24.cz",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Active24",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ACTIVE24_API_KEY": {
        "type": "string",
        "title": "ACTIVE24_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "ACTIVE24_HTTP_TIMEOUT": {
        "type": "string",
        "title": "ACTIVE24_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "ACTIVE24_POLLING_INTERVAL": {
        "type": "string",
        "title": "ACTIVE24_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "ACTIVE24_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "ACTIVE24_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "ACTIVE24_SECRET": {
        "type": "string",
        "title": "ACTIVE24_SECRET",
        "description": "Secret",
        "secret": true,
        "x-group": "credentials"
      },
      "ACTIVE24_TTL": {
        "type": "string",
        "title": "ACTIVE24_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
