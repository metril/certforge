{
  "code": "namecheap",
  "name": "Namecheap",
  "url": "https://www.namecheap.com",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Namecheap",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "NAMECHEAP_API_KEY": {
        "type": "string",
        "title": "NAMECHEAP_API_KEY",
        "description": "API key",
        "secret": true,
        "x-group": "credentials"
      },
      "NAMECHEAP_API_USER": {
        "type": "string",
        "title": "NAMECHEAP_API_USER",
        "description": "API user",
        "secret": false,
        "x-group": "credentials"
      },
      "NAMECHEAP_HTTP_TIMEOUT": {
        "type": "string",
        "title": "NAMECHEAP_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "NAMECHEAP_POLLING_INTERVAL": {
        "type": "string",
        "title": "NAMECHEAP_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 15)",
        "secret": false,
        "x-group": "additional"
      },
      "NAMECHEAP_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "NAMECHEAP_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 3600)",
        "secret": false,
        "x-group": "additional"
      },
      "NAMECHEAP_SANDBOX": {
        "type": "string",
        "title": "NAMECHEAP_SANDBOX",
        "description": "Activate the sandbox (boolean)",
        "secret": false,
        "x-group": "additional"
      },
      "NAMECHEAP_TTL": {
        "type": "string",
        "title": "NAMECHEAP_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "user-key",
        "label": "User + Key",
        "fields": [
          "NAMECHEAP_API_USER",
          "NAMECHEAP_API_KEY"
        ],
        "optional": []
      }
    ]
  }
}
