{
  "code": "onecloudru",
  "name": "1cloud.ru",
  "url": "https://1cloud.ru/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "1cloud.ru",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ONECLOUDRU_HTTP_TIMEOUT": {
        "type": "string",
        "title": "ONECLOUDRU_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "ONECLOUDRU_POLLING_INTERVAL": {
        "type": "string",
        "title": "ONECLOUDRU_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "ONECLOUDRU_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "ONECLOUDRU_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "ONECLOUDRU_TOKEN": {
        "type": "string",
        "title": "ONECLOUDRU_TOKEN",
        "description": "API token",
        "secret": true,
        "x-group": "credentials"
      },
      "ONECLOUDRU_TTL": {
        "type": "string",
        "title": "ONECLOUDRU_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "token",
        "label": "Token",
        "fields": [
          "ONECLOUDRU_TOKEN"
        ],
        "optional": []
      }
    ]
  }
}
