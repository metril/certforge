{
  "code": "liquidweb",
  "name": "Liquid Web",
  "url": "https://liquidweb.com",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Liquid Web",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "LWAPI_HTTP_TIMEOUT": {
        "type": "string",
        "title": "LWAPI_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "LWAPI_PASSWORD": {
        "type": "string",
        "title": "LWAPI_PASSWORD",
        "description": "Liquid Web API Password",
        "secret": true,
        "x-group": "credentials"
      },
      "LWAPI_POLLING_INTERVAL": {
        "type": "string",
        "title": "LWAPI_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "LWAPI_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "LWAPI_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "LWAPI_TTL": {
        "type": "string",
        "title": "LWAPI_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 300)",
        "secret": false,
        "x-group": "additional"
      },
      "LWAPI_URL": {
        "type": "string",
        "title": "LWAPI_URL",
        "description": "Liquid Web API endpoint",
        "secret": false,
        "x-group": "additional"
      },
      "LWAPI_USERNAME": {
        "type": "string",
        "title": "LWAPI_USERNAME",
        "description": "Liquid Web API Username",
        "secret": false,
        "x-group": "credentials"
      },
      "LWAPI_ZONE": {
        "type": "string",
        "title": "LWAPI_ZONE",
        "description": "DNS Zone",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
