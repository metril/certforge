{
  "code": "derak",
  "name": "Derak Cloud",
  "url": "https://derak.cloud/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Derak Cloud",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "DERAK_API_KEY": {
        "type": "string",
        "title": "DERAK_API_KEY",
        "description": "The API key",
        "secret": true,
        "x-group": "credentials"
      },
      "DERAK_HTTP_TIMEOUT": {
        "type": "string",
        "title": "DERAK_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "DERAK_POLLING_INTERVAL": {
        "type": "string",
        "title": "DERAK_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 5)",
        "secret": false,
        "x-group": "additional"
      },
      "DERAK_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "DERAK_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "DERAK_TTL": {
        "type": "string",
        "title": "DERAK_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "DERAK_WEBSITE_ID": {
        "type": "string",
        "title": "DERAK_WEBSITE_ID",
        "description": "Force the zone/website ID",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
