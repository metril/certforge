{
  "code": "epik",
  "name": "Epik",
  "url": "https://www.epik.com/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Epik",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "EPIK_HTTP_TIMEOUT": {
        "type": "string",
        "title": "EPIK_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "EPIK_POLLING_INTERVAL": {
        "type": "string",
        "title": "EPIK_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "EPIK_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "EPIK_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "EPIK_SIGNATURE": {
        "type": "string",
        "title": "EPIK_SIGNATURE",
        "description": "Epik API signature (https://registrar.epik.com/account/api-settings/)",
        "secret": false,
        "x-group": "credentials"
      },
      "EPIK_TTL": {
        "type": "string",
        "title": "EPIK_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 3600)",
        "secret": false,
        "x-group": "additional"
      }
    }
  }
}
