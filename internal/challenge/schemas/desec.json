{
  "code": "desec",
  "name": "deSEC.io",
  "url": "https://desec.io",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "deSEC.io",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "DESEC_HTTP_TIMEOUT": {
        "type": "string",
        "title": "DESEC_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "DESEC_POLLING_INTERVAL": {
        "type": "string",
        "title": "DESEC_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 4)",
        "secret": false,
        "x-group": "additional"
      },
      "DESEC_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "DESEC_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      },
      "DESEC_TOKEN": {
        "type": "string",
        "title": "DESEC_TOKEN",
        "description": "Domain token",
        "secret": true,
        "x-group": "credentials"
      },
      "DESEC_TTL": {
        "type": "string",
        "title": "DESEC_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 3600)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "token",
        "label": "Token",
        "fields": [
          "DESEC_TOKEN"
        ],
        "optional": []
      }
    ]
  }
}
