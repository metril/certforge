{
  "code": "gcore",
  "name": "G-Core",
  "url": "https://gcore.com/dns/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "G-Core",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "GCORE_HTTP_TIMEOUT": {
        "type": "string",
        "title": "GCORE_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 10)",
        "secret": false,
        "x-group": "additional"
      },
      "GCORE_PERMANENT_API_TOKEN": {
        "type": "string",
        "title": "GCORE_PERMANENT_API_TOKEN",
        "description": "Permanent API token (https://gcore.com/blog/permanent-api-token-explained/)",
        "secret": true,
        "x-group": "credentials"
      },
      "GCORE_POLLING_INTERVAL": {
        "type": "string",
        "title": "GCORE_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 20)",
        "secret": false,
        "x-group": "additional"
      },
      "GCORE_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "GCORE_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 360)",
        "secret": false,
        "x-group": "additional"
      },
      "GCORE_TTL": {
        "type": "string",
        "title": "GCORE_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "permanent-api-token",
        "label": "Permanent API token",
        "fields": [
          "GCORE_PERMANENT_API_TOKEN"
        ],
        "optional": []
      }
    ]
  }
}
