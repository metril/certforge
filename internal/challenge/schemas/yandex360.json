        "x-group": "additional"
      },
      "YANDEX360_OAUTH_TOKEN": {
        "type": "string",
        "title": "YANDEX360_OAUTH_TOKEN",
        "description": "The OAuth Token",
        "secret": true,
        "x-group": "credentials"
      },
      "YANDEX360_ORG_ID": {
        "type": "string",
        "title": "YANDEX360_ORG_ID",
        "description": "The organization ID",
