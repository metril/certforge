{
  "code": "binarylane",
  "name": "Binary Lane",
  "url": "https://www.binarylane.com.au/",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Binary Lane",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "BINARYLANE_API_TOKEN": {
        "type": "string",
        "title": "BINARYLANE_API_TOKEN",
        "description": "API token",
        "secret": true,
        "x-group": "credentials"
      },
      "BINARYLANE_HTTP_TIMEOUT": {
        "type": "string",
        "title": "BINARYLANE_HTTP_TIMEOUT",
        "description": "API request timeout in seconds (Default: 30)",
        "secret": false,
        "x-group": "additional"
      },
      "BINARYLANE_POLLING_INTERVAL": {
        "type": "string",
        "title": "BINARYLANE_POLLING_INTERVAL",
        "description": "Time between DNS propagation check in seconds (Default: 2)",
        "secret": false,
        "x-group": "additional"
      },
      "BINARYLANE_PROPAGATION_TIMEOUT": {
        "type": "string",
        "title": "BINARYLANE_PROPAGATION_TIMEOUT",
        "description": "Maximum waiting time for DNS propagation in seconds (Default: 60)",
        "secret": false,
        "x-group": "additional"
      },
      "BINARYLANE_TTL": {
        "type": "string",
        "title": "BINARYLANE_TTL",
        "description": "The TTL of the TXT record used for the DNS challenge in seconds (Default: 120)",
        "secret": false,
        "x-group": "additional"
      }
    },
    "x-auth-methods": [
      {
        "id": "api-token",
        "label": "API token",
        "fields": [
          "BINARYLANE_API_TOKEN"
        ],
        "optional": []
      }
    ]
  }
}
